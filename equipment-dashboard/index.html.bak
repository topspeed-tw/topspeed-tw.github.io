<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="設備管理">
<meta name="theme-color" content="#3498db">
<title>電腦設備管理系統</title>
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, "Microsoft JhengHei", "Microsoft YaHei", sans-serif; background:#f5f7fa; color:#2c3e50; }
.app { max-width: 1400px; margin: 0 auto; padding: 16px; }
header { background:#fff; border-radius:10px; padding:20px 24px; box-shadow:0 1px 3px rgba(0,0,0,.06); margin-bottom:16px; }
h1 { font-size:22px; margin-bottom:6px; }
h2 { font-size:18px; margin-bottom:12px; }
h3 { font-size:14px; margin:14px 0 8px; color:#34495e; }
.subtitle { color:#7f8c8d; font-size:13px; }
.stats { display:grid; grid-template-columns: repeat(auto-fit, minmax(140px,1fr)); gap:12px; margin-top:16px; }
.stat { background:#f8f9fb; padding:12px 16px; border-radius:8px; border-left:3px solid #3498db; }
.stat .num { font-size:22px; font-weight:700; color:#2c3e50; }
.stat .lbl { font-size:12px; color:#7f8c8d; }
.tabs { display:flex; gap:4px; margin-bottom:16px; background:#fff; padding:6px; border-radius:8px; box-shadow:0 1px 3px rgba(0,0,0,.06); overflow-x:auto; }
.tab { flex:1; min-width:90px; padding:10px; text-align:center; border-radius:6px; cursor:pointer; font-weight:500; font-size:14px; color:#7f8c8d; user-select:none; }
.tab.active { background:#3498db; color:#fff; }
.tab:hover:not(.active) { background:#ecf0f1; color:#2c3e50; }
.panel { background:#fff; border-radius:10px; padding:20px; box-shadow:0 1px 3px rgba(0,0,0,.06); }
.toolbar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; align-items:center; }
.toolbar input, .toolbar select { padding:8px 12px; border:1px solid #dde2e8; border-radius:6px; font-size:13px; background:#fff; }
.toolbar input[type="text"], .toolbar input[type="search"] { flex:1; min-width:200px; }
.toolbar .count { color:#7f8c8d; font-size:13px; margin-left:auto; }
table { width:100%; border-collapse:collapse; font-size:13px; }
th { background:#f8f9fb; padding:10px 8px; text-align:left; font-weight:600; color:#34495e; border-bottom:2px solid #e1e6ec; cursor:pointer; user-select:none; white-space:nowrap; }
th:hover { background:#eef1f5; }
td { padding:10px 8px; border-bottom:1px solid #f0f3f7; vertical-align:top; }
tr:hover td { background:#fafbfd; }
.badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:500; }
.b-blue { background:#dbeafe; color:#1e40af; }
.b-green { background:#d1fae5; color:#065f46; }
.b-yellow { background:#fef3c7; color:#92400e; }
.b-red { background:#fee2e2; color:#991b1b; }
.b-gray { background:#e5e7eb; color:#374151; }
.b-orange { background:#fed7aa; color:#9a3412; }
.btn { padding:8px 14px; background:#3498db; color:#fff; border:none; border-radius:6px; cursor:pointer; font-size:13px; font-family:inherit; }
.btn:hover { background:#2980b9; }
.btn:disabled { background:#bdc3c7; cursor:not-allowed; }
.btn-sm { padding:4px 10px; font-size:12px; }
.btn-ghost { background:#fff; color:#3498db; border:1px solid #3498db; }
.btn-ghost:hover { background:#ecf3fa; }
.btn-danger { background:#e74c3c; }
.btn-danger:hover { background:#c0392b; }
.btn-success { background:#27ae60; }
.btn-success:hover { background:#1e8449; }
.btn-warning { background:#f39c12; }
.btn-warning:hover { background:#d68910; }
.empty { text-align:center; color:#bdc3c7; padding:40px; }
.scroll { overflow-x:auto; }
details { margin:6px 0; }
details summary { cursor:pointer; color:#3498db; font-size:12px; }
.history-list { margin-top:6px; padding-left:14px; font-size:12px; color:#7f8c8d; }
.history-list li { margin:3px 0; }
.muted { color:#bdc3c7; }
.action-cell { display:flex; gap:4px; flex-wrap:wrap; min-width: 145px;}

/* 員工持有設備清單 */
.dev-list { display:flex; flex-direction:column; gap:6px; min-width:260px; }
.dev-item { display:flex; align-items:center; flex-wrap:wrap; gap:4px; padding:6px 8px; background:#f8fafc; border-left:3px solid #3498db; border-radius:4px; font-size:12.5px; }
.dev-item strong { color:#2c3e50; font-family:'Consolas','Microsoft JhengHei',monospace; }
.dev-detail { color:#7f8c8d; font-size:11.5px; margin-left:6px; }

/* Setup screen */
.setup { background:#fff; border-radius:10px; padding:40px; box-shadow:0 1px 3px rgba(0,0,0,.06); max-width:700px; margin:40px auto; }
.setup h1 { margin-bottom:6px; }
.setup .field { margin:14px 0; }
.setup label { display:block; margin-bottom:6px; font-weight:500; font-size:13px; }
.setup input { width:100%; padding:10px 12px; border:1px solid #dde2e8; border-radius:6px; font-size:13px; }
.setup .help { font-size:12px; color:#7f8c8d; margin-top:4px; }
.setup .error { color:#e74c3c; font-size:13px; margin-top:10px; }
.setup .ok { color:#27ae60; font-size:13px; margin-top:10px; }

/* Modal */
.modal-bg { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,.5); display:none; z-index:100; align-items:flex-start; justify-content:center; padding-top:40px; }
.modal-bg.show { display:flex; }
.modal { background:#fff; border-radius:10px; padding:24px; max-width:600px; width:90%; max-height:85vh; overflow-y:auto; }
.modal h2 { margin-bottom:14px; }
.field { margin:10px 0; }
.field label { display:block; margin-bottom:5px; font-size:13px; font-weight:500; color:#34495e; }
.field input, .field select, .field textarea { width:100%; padding:8px 12px; border:1px solid #dde2e8; border-radius:6px; font-size:13px; font-family:inherit; }
.field textarea { resize:vertical; min-height:60px; }
.field-row { display:flex; gap:10px; }
.field-row > .field { flex:1; }
.modal-actions { margin-top:18px; display:flex; gap:8px; justify-content:flex-end; }
.notice { padding:10px 14px; border-radius:6px; font-size:13px; margin:10px 0; }
.notice-info { background:#e8f4fd; color:#1e40af; }
.notice-error { background:#fee; color:#991b1b; }
.notice-success { background:#e8f8f0; color:#0a6e3d; }

.toast { position:fixed; bottom:20px; right:20px; background:#2c3e50; color:#fff; padding:12px 20px; border-radius:6px; box-shadow:0 4px 10px rgba(0,0,0,.2); z-index:200; opacity:0; transition:opacity .3s; }
.toast.show { opacity:1; }
.toast.success { background:#27ae60; }
.toast.error { background:#e74c3c; }

.loading-overlay { position:fixed; inset:0; background:rgba(255,255,255,.6); display:none; align-items:center; justify-content:center; z-index:150; }
.loading-overlay.show { display:flex; }
.spinner { width:40px; height:40px; border:3px solid #ecf0f1; border-top-color:#3498db; border-radius:50%; animation:spin 0.8s linear infinite; }
@keyframes spin { to { transform:rotate(360deg); } }

@media (max-width: 768px) {
  .app { padding: 10px; }
  header { padding: 14px 16px; }
  h1 { font-size: 18px; }
  .stats { grid-template-columns: repeat(2, 1fr); gap: 8px; margin-top: 12px; }
  .stat { padding: 10px 12px; }
  .stat .num { font-size: 18px; }
  .stat .lbl { font-size: 11px; }
  .panel { padding: 12px; }
  .tabs { gap: 2px; padding: 4px; }
  .tab { padding: 8px 4px; font-size: 12px; min-width: auto; }
  .toolbar { gap: 6px; }
  .toolbar input, .toolbar select { font-size: 14px; padding: 10px 12px; }
  .toolbar input[type="text"], .toolbar input[type="search"] { width: 100%; flex: 1 1 100%; }
  .toolbar select { flex: 1 1 calc(50% - 3px); min-width: 0; }
  .toolbar .count { margin-left: 0; flex: 1 1 100%; text-align: right; }
  .toolbar .btn { width: 100%; padding: 12px; font-size: 14px; }
  .btn { padding: 10px 14px; font-size: 14px; }
  .btn-sm { padding: 6px 10px; font-size: 12px; }

  /* 表格 → 卡片式 */
  .scroll { overflow-x: visible; }
  table thead { display: none; }
  table, tbody, tr, td { display: block; width: 100%; }
  tr {
    background: #fff;
    border: 1px solid #e1e6ec;
    border-radius: 8px;
    margin-bottom: 10px;
    padding: 12px;
    box-shadow: 0 1px 2px rgba(0,0,0,.04);
  }
  tr:hover td { background: transparent; }
  td {
    border-bottom: 1px dashed #f0f3f7;
    padding: 6px 0;
    font-size: 13px;
    text-align: left;
  }
  td:last-child { border-bottom: none; }
  td::before {
    content: attr(data-label);
    display: inline-block;
    width: 90px;
    font-weight: 600;
    color: #7f8c8d;
    font-size: 12px;
  }
  td.action-cell { flex-wrap: wrap; gap: 6px; padding-top: 10px; }
  td.action-cell::before { display: none; }
  td.action-cell .btn { flex: 1 1 calc(33% - 4px); min-width: 70px; text-align: center; }
  .empty { display: block; }
  tr.empty-row td::before { display: none; }

  /* Modal */
  .modal-bg { padding: 10px; align-items: flex-start; padding-top: 20px; }
  .modal { width: 100%; max-width: 100%; padding: 16px; max-height: 90vh; }
  .modal h2 { font-size: 16px; margin-bottom: 10px; }
  .field { margin: 8px 0; }
  .field input, .field select, .field textarea { font-size: 16px; padding: 10px 12px; }
  .field-row { flex-direction: column; gap: 8px; }
  .modal-actions { flex-direction: column; gap: 6px; }
  .modal-actions .btn { width: 100%; padding: 12px; font-size: 14px; }
  .modal-actions .btn[style*="margin-left:auto"] { margin-left: 0 !important; }

  /* Setup */
  .setup { padding: 24px 16px; margin: 20px auto; }

  /* Toast */
  .toast { left: 10px; right: 10px; bottom: 10px; text-align: center; }
}
</style>
</head>
<body>
<div class="app">

<!-- SETUP -->
<div id="setup" class="setup" style="display:none">
  <h1>📦 電腦設備管理系統</h1>
  <p class="subtitle">第一次使用,請設定 Google Apps Script 連線</p>
  <div class="field">
    <label>Web App URL</label>
    <input type="text" id="setup-url" placeholder="https://script.google.com/macros/s/.../exec">
    <!-- <div class="help">部署 Google Apps Script 後拿到的網址</div> -->
  </div>
  <div class="field">
    <label>API Key</label>
    <input type="text" id="setup-key" placeholder="你在 backend.gs 設定的 API_KEY">
    <!-- <div class="help">必須與 Apps Script 程式碼中 API_KEY 一致</div> -->
  </div>
  <button class="btn" id="setup-btn">儲存並連線</button>
  <div id="setup-msg"></div>
</div>

<!-- DASHBOARD -->
<div id="dashboard" style="display:none">
<header>
  <div style="display:flex; justify-content:space-between; align-items:start; flex-wrap:wrap; gap:10px">
    <div>
      <h1>📦 電腦設備管理系統</h1>
      <div class="subtitle" id="subtitle">資料來自 Google Sheets</div>
    </div>
    <div style="display:flex; gap:6px; flex-wrap:wrap">
      <button class="btn btn-ghost btn-sm" id="refresh-btn">🔄 重新整理</button>
      <button class="btn btn-ghost btn-sm" id="export-btn">📥 匯出 Excel</button>
      <button class="btn btn-ghost btn-sm" id="settings-btn">⚙️ 連線設定</button>
    </div>
  </div>
  <div class="stats" id="stats"></div>
</header>

<div class="tabs">
  <div class="tab active" data-tab="equipment">📦 設備清單</div>
  <div class="tab" data-tab="employees">👥 員工</div>
  <div class="tab" data-tab="events">📋 異動歷史</div>
  <div class="tab" data-tab="types">🏷️ 設備種類</div>
</div>

<!-- Equipment tab -->
<div class="panel" id="panel-equipment">
  <div class="toolbar">
    <button class="btn btn-success" onclick="openAddEquipment()">+ 新增設備</button>
    <input type="search" id="eq-search" placeholder="搜尋設備編號、使用者、設備明細...">
    <select id="eq-type"><option value="">所有類型</option></select>
    <select id="eq-status"><option value="">所有狀態</option></select>
    <select id="eq-dept"><option value="">所有部門</option></select>
    <span class="count" id="eq-count"></span>
  </div>
  <div class="scroll"><table id="eq-table"></table></div>
</div>

<!-- Employees tab -->
<div class="panel" id="panel-employees" style="display:none">
  <div class="toolbar">
    <button class="btn btn-success" onclick="openAddEmployee()">+ 新增員工</button>
    <input type="search" id="emp-search" placeholder="搜尋員工姓名/部門...">
    <select id="emp-status">
      <option value="">所有狀態</option>
      <option value="在職">在職</option>
      <option value="已離職">已離職</option>
    </select>
    <span class="count" id="emp-count"></span>
  </div>
  <div class="scroll"><table id="emp-table"></table></div>
</div>

<!-- Events tab -->
<div class="panel" id="panel-events" style="display:none">
  <div class="toolbar">
    <input type="search" id="ev-search" placeholder="搜尋設備編號、姓名、原因...">
    <select id="ev-type">
      <option value="">所有類型</option>
      <option value="轉移">轉移</option>
      <option value="送出">送出</option>
      <option value="報廢">報廢</option>
    </select>
    <span class="count" id="ev-count"></span>
  </div>
  <div class="scroll"><table id="ev-table"></table></div>
</div>

<!-- Types tab -->
<div class="panel" id="panel-types" style="display:none">
  <p style="font-size:13px; color:#7f8c8d; margin-bottom:14px">
    管理設備類型與編號代碼。新增設備時,系統會用「編號代碼 + 年份 + 流水號」自動產生設備編號(例如 NB26003)。
  </p>
  <div class="toolbar">
    <button class="btn btn-success" onclick="openAddType()">+ 新增類型</button>
    <span class="count" id="type-count"></span>
  </div>
  <div class="scroll"><table id="type-table"></table></div>
</div>
</div>

</div>

<!-- Modals -->
<div id="modal-bg" class="modal-bg" onclick="if(event.target===this) closeModal()">
  <div class="modal" id="modal-content"></div>
</div>

<!-- Loading + Toast -->
<div class="loading-overlay" id="loading"><div class="spinner"></div></div>
<div class="toast" id="toast"></div>

<script>
// ============ State ============
const SETTINGS_KEY = 'gsdb_equipment_settings_v1';
let CONFIG = { url: '', key: '' };
let DATA = { equipment: [], employees: [], events: [], types: [] };
let eventsByDevice = {}, devicesByEmployee = {};

// ============ API ============
async function api(action, payload = {}) {
  if (!CONFIG.url || !CONFIG.key) throw new Error('未設定');
  const url = CONFIG.url + '?key=' + encodeURIComponent(CONFIG.key);
  showLoading(true);
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: {'Content-Type': 'text/plain;charset=utf-8'},
      body: JSON.stringify({action, ...payload}),
      redirect: 'follow'
    });
    const text = await res.text();
    let j;
    try { j = JSON.parse(text); } catch(e) { throw new Error('回應不是 JSON: ' + text.slice(0,200)); }
    if (!j.ok) throw new Error(j.error || '未知錯誤');
    return j.data;
  } finally { showLoading(false); }
}

async function refresh() {
  try {
    DATA = await api('read');
    buildIndexes();
    renderAll();
    showToast('已重新載入', 'success');
  } catch (e) {
    showToast('讀取失敗: ' + e.message, 'error');
  }
}

// ============ Indexes ============
function buildIndexes() {
  eventsByDevice = {};
  DATA.events.forEach(e => {
    if (!eventsByDevice[e.設備編號]) eventsByDevice[e.設備編號] = [];
    eventsByDevice[e.設備編號].push(e);
  });
  // 每台設備:沒日期=最舊(排最前面,因為通常是早期不知日期的紀錄)
  Object.values(eventsByDevice).forEach(arr => arr.sort((a,b) => {
    const da = formatDate(a.日期), db = formatDate(b.日期);
    if (!da && !db) return 0;
    if (!da) return -1;
    if (!db) return 1;
    return da.localeCompare(db);
  }));
  devicesByEmployee = {};
  DATA.equipment.forEach(d => {
    if (!d.使用者) return;
    if (!devicesByEmployee[d.使用者]) devicesByEmployee[d.使用者] = [];
    devicesByEmployee[d.使用者].push(d);
  });
}

// ============ Render ============
function badge(t, c) { return t ? `<span class="badge ${c}">${escapeHtml(t)}</span>` : ''; }
function typeBadgeCls(t) { const m = {'桌上型電腦':'b-blue','筆記型電腦':'b-green','螢幕':'b-gray','智慧型手機':'b-orange','iMac':'b-blue','MacBook':'b-green','電視':'b-gray','其他':'b-gray','平板':'b-blue'}; return m[t]||'b-gray'; }
function statusCls(s) { const m = {'使用中':'b-green','備用':'b-yellow','已報廢':'b-red','已送出':'b-gray'}; return m[s]||'b-gray'; }
function holdCls(h) { const m = {'使用中':'b-green','保管中':'b-yellow'}; return m[h]||''; }
function evCls(t) { const m = {'轉移':'b-blue','報廢':'b-red','送出':'b-gray'}; return m[t]||'b-gray'; }

function renderStats() {
  const total = DATA.equipment.length;
  const active = DATA.equipment.filter(d => d.狀態 === '使用中').length;
  const standby = DATA.equipment.filter(d => d.狀態 === '備用').length;
  const scrapped = DATA.equipment.filter(d => d.狀態 === '已報廢').length;
  const activeEmp = DATA.employees.filter(e => e.在職狀態 === '在職').length;
  document.getElementById('stats').innerHTML = `
    <div class="stat" style="border-color:#3498db"><div class="num">${total}</div><div class="lbl">總設備</div></div>
    <div class="stat" style="border-color:#27ae60"><div class="num">${active}</div><div class="lbl">使用中</div></div>
    <div class="stat" style="border-color:#f39c12"><div class="num">${standby}</div><div class="lbl">備用</div></div>
    <div class="stat" style="border-color:#e74c3c"><div class="num">${scrapped}</div><div class="lbl">已報廢</div></div>
    <div class="stat" style="border-color:#9b59b6"><div class="num">${activeEmp}</div><div class="lbl">在職員工</div></div>
  `;
}

let eqSort = {col: '設備編號', dir: 1};
function renderEquipment() {
  const q = document.getElementById('eq-search').value.toLowerCase().trim();
  const type = document.getElementById('eq-type').value;
  const status = document.getElementById('eq-status').value;
  const dept = document.getElementById('eq-dept').value;
  let rows = DATA.equipment.filter(d => {
    if (type && d.設備類型 !== type) return false;
    if (status && d.狀態 !== status) return false;
    if (dept && d.單位部門 !== dept) return false;
    if (q && ![d.設備編號, d.使用者, d.設備明細, d.目前位置, d.備註].join(' ').toLowerCase().includes(q)) return false;
    return true;
  });
  rows.sort((a,b) => eqSort.dir * (a[eqSort.col]||'').toString().localeCompare((b[eqSort.col]||'').toString()));
  document.getElementById('eq-count').textContent = `共 ${rows.length} 筆`;
  const cols = ['設備編號','設備類型','使用者','單位部門','狀態','購買日期','購買價格(NTD)','設備明細','目前位置'];
  let html = '<thead><tr>';
  cols.forEach(c => html += `<th data-col="${c}">${c}${eqSort.col===c ? (eqSort.dir>0?' ↑':' ↓'):''}</th>`);
  html += '<th>異動歷史</th><th>操作</th></tr></thead><tbody>';
  rows.forEach(d => {
    html += '<tr>';
    html += `<td data-label="設備編號"><strong>${escapeHtml(d.設備編號)}</strong></td>`;
    html += `<td data-label="類型">${badge(d.設備類型, typeBadgeCls(d.設備類型))}</td>`;
    const _userHoldMark = d.保管狀態 === '保管中' ? ' <span class="badge b-yellow">🔒保管</span>' : '';
    html += `<td data-label="使用者">${escapeHtml(d.使用者)||'<span class="muted">—</span>'}${_userHoldMark}</td>`;
    html += `<td data-label="部門">${escapeHtml(d.單位部門)||'<span class="muted">—</span>'}</td>`;
    html += `<td data-label="狀態">${badge(d.狀態, statusCls(d.狀態))}</td>`;
    html += `<td data-label="購買日期">${escapeHtml(d.購買日期)||'<span class="muted">—</span>'}</td>`;
    html += `<td data-label="購買價格">${d['購買價格(NTD)'] ? Number(d['購買價格(NTD)']).toLocaleString() : '<span class="muted">—</span>'}</td>`;
    html += `<td data-label="設備明細">${escapeHtml(d.設備明細)||'<span class="muted">—</span>'}</td>`;
    html += `<td data-label="目前位置">${escapeHtml(d.目前位置)||'<span class="muted">—</span>'}</td>`;
    const evs = eventsByDevice[d.設備編號] || [];
    if (evs.length) {
      html += `<td data-label="異動歷史"><details><summary>${evs.length} 筆</summary><ul class="history-list">`;
      evs.forEach(e => {
        const detail = e.異動類型 === '轉移'
          ? `${escapeHtml(e.原使用者)||'—'} → ${escapeHtml(e.新使用者)||'—'}${holdBadgeSmall(e.新保管狀態)}`
          : escapeHtml(e.原因 || e.異動類型);
        html += `<li>${formatDate(e.日期)||'—'} ${badge(e.異動類型, evCls(e.異動類型))} ${detail}</li>`;
      });
      html += '</ul></details></td>';
    } else html += '<td data-label="異動歷史"><span class="muted">無</span></td>';
    html += `<td class="action-cell">
      <button class="btn btn-sm" onclick="openEditEquipment('${escapeAttr(d.設備編號)}')">編輯</button>
      <button class="btn btn-sm btn-warning" onclick="openTransfer('${escapeAttr(d.設備編號)}')">轉移</button>
      <button class="btn btn-sm btn-ghost" onclick="openMore('${escapeAttr(d.設備編號)}')">⋯</button>
    </td>`;
    html += '</tr>';
  });
  if (!rows.length) html += '<tr class="empty-row"><td colspan="11" class="empty">沒有符合的設備</td></tr>';
  html += '</tbody>';
  document.getElementById('eq-table').innerHTML = html;
  document.querySelectorAll('#eq-table th').forEach(th => {
    if (th.dataset.col) th.onclick = () => {
      if (eqSort.col === th.dataset.col) eqSort.dir *= -1;
      else { eqSort.col = th.dataset.col; eqSort.dir = 1; }
      renderEquipment();
    };
  });
}

function renderEmployees() {
  const q = document.getElementById('emp-search').value.toLowerCase().trim();
  const status = document.getElementById('emp-status').value;
  let rows = DATA.employees.filter(e => {
    if (status && normJob(e.在職狀態) !== status) return false;
    if (q && ![e.姓名, e.部門].join(' ').toLowerCase().includes(q)) return false;
    return true;
  });
  rows.sort((a,b) => (a.姓名||'').localeCompare(b.姓名||''));
  document.getElementById('emp-count').textContent = `共 ${rows.length} 位`;
  let html = '<thead><tr><th>姓名</th><th>部門</th><th>在職狀態</th><th>持有設備數</th><th>持有設備</th><th>操作</th></tr></thead><tbody>';
  rows.forEach(e => {
    const devs = devicesByEmployee[e.姓名] || [];
    const _hasHold = devs.some(d => d.保管狀態 === '保管中');
    const _holdSummaryMark = _hasHold ? ' <span class="badge b-yellow" style="font-size:10px">🔒含保管</span>' : '';
    const devCellHtml = devs.length
      ? '<details><summary>展開 ' + devs.length + ' 台' + _holdSummaryMark + '</summary>'
        + '<div class="dev-list" style="margin-top:6px">' + devs.map(d => {
          const hold = d.保管狀態 === '保管中'
            ? '<span class="badge b-yellow" style="margin-left:6px">🔒保管</span>'
            : '';
          return '<div class="dev-item">'
            + '<strong>' + escapeHtml(d.設備編號) + '</strong>'
            + ' <span class="badge ' + typeBadgeCls(d.設備類型) + '">' + escapeHtml(d.設備類型) + '</span>'
            + hold
            + (d.設備明細 ? '<span class="dev-detail">' + escapeHtml(d.設備明細) + '</span>' : '')
            + '</div>';
        }).join('') + '</div></details>'
      : '<span class="muted">無</span>';
    html += `<tr><td data-label="姓名"><strong>${escapeHtml(e.姓名)}</strong></td>
      <td data-label="部門">${escapeHtml(e.部門)||'<span class="muted">—</span>'}</td>
      <td data-label="狀態">${badge(normJob(e.在職狀態), e.在職狀態==='在職'?'b-green':'b-gray')}</td>
      <td data-label="設備數">${devs.length}</td>
      <td data-label="持有設備">${devCellHtml}</td>
      <td class="action-cell">
        <button class="btn btn-sm" onclick="openEditEmployee('${escapeAttr(e.姓名)}')">編輯</button>
        ${devs.length === 0 ? `<button class="btn btn-sm btn-danger" onclick="deleteEmployee('${escapeAttr(e.姓名)}')">刪除</button>` : ''}
      </td></tr>`;
  });
  if (!rows.length) html += '<tr class="empty-row"><td colspan="6" class="empty">沒有符合的員工</td></tr>';
  html += '</tbody>';
  document.getElementById('emp-table').innerHTML = html;
}

// 「已離職/未知」(舊資料)統一視為「已離職」
function normJob(s) {
  if (!s) return '';
  return s === '已離職/未知' ? '已離職' : s;
}

function holdBadgeSmall(holdStatus) {
  if (holdStatus === '保管中') return ' <span class="badge b-yellow">🔒保管</span>';
  if (holdStatus === '使用中') return ' <span class="badge b-green">使用</span>';
  return '';
}

// 任何日期值統一格式化成 yyyy-mm-dd;無法解析則回傳空字串
function formatDate(d) {
  if (!d) return '';
  const s = String(d).trim();
  if (!s) return '';
  // 已經是 yyyy-mm-dd
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  // yyyy/mm/dd 或 yyyy/m/d
  let m = s.match(/^(\d{4})\/(\d{1,2})\/(\d{1,2})/);
  if (m) return `${m[1]}-${m[2].padStart(2,'0')}-${m[3].padStart(2,'0')}`;
  // ISO datetime
  m = s.match(/^(\d{4})-(\d{2})-(\d{2})T/);
  if (m) return `${m[1]}-${m[2]}-${m[3]}`;
  // 嘗試讓 JS 解析
  const t = Date.parse(s);
  if (!isNaN(t)) {
    const d2 = new Date(t);
    const y = d2.getFullYear();
    const mo = String(d2.getMonth()+1).padStart(2,'0');
    const dd = String(d2.getDate()).padStart(2,'0');
    return `${y}-${mo}-${dd}`;
  }
  return s;
}

function renderEvents() {
  const q = document.getElementById('ev-search').value.toLowerCase().trim();
  const type = document.getElementById('ev-type').value;
  let rows = DATA.events.filter(e => {
    if (type && e.異動類型 !== type) return false;
    if (q && ![e.設備編號, e.原使用者, e.新使用者, e.原因].join(' ').toLowerCase().includes(q)) return false;
    return true;
  });
  // 新到舊;沒有日期算最舊(排最下面)
  rows.sort((a,b) => {
    const da = formatDate(a.日期), db = formatDate(b.日期);
    if (!da && !db) return 0;
    if (!da) return 1;   // a 沒日期 -> a 排後面
    if (!db) return -1;  // b 沒日期 -> b 排後面
    return db.localeCompare(da);
  });
  document.getElementById('ev-count').textContent = `共 ${rows.length} 筆`;
  let html = '<thead><tr><th>日期</th><th>設備編號</th><th>異動類型</th><th>原使用者</th><th>新使用者</th><th>原因</th></tr></thead><tbody>';
  rows.forEach(e => {
    const newUserCell = e.新使用者
      ? escapeHtml(e.新使用者) + holdBadgeSmall(e.新保管狀態)
      : '<span class="muted">—</span>';
    const dateStr = formatDate(e.日期);
    html += `<tr><td data-label="日期">${dateStr||'<span class="muted">—</span>'}</td>
      <td data-label="設備編號"><strong>${escapeHtml(e.設備編號)}</strong></td>
      <td data-label="類型">${badge(e.異動類型, evCls(e.異動類型))}</td>
      <td data-label="原使用者">${escapeHtml(e.原使用者)||'<span class="muted">—</span>'}</td>
      <td data-label="新使用者">${newUserCell}</td>
      <td data-label="原因">${escapeHtml(e.原因)||'<span class="muted">—</span>'}</td></tr>`;
  });
  if (!rows.length) html += '<tr class="empty-row"><td colspan="6" class="empty">沒有符合的異動</td></tr>';
  html += '</tbody>';
  document.getElementById('ev-table').innerHTML = html;
}

function renderTypes() {
  document.getElementById('type-count').textContent = `共 ${DATA.types.length} 種`;
  let html = '<thead><tr><th>類型名稱</th><th>編號代碼</th><th>使用中設備數</th><th>操作</th></tr></thead><tbody>';
  DATA.types.forEach(t => {
    const count = DATA.equipment.filter(d => d.設備類型 === t.類型名稱).length;
    html += `<tr><td data-label="類型"><strong>${escapeHtml(t.類型名稱)}</strong></td>
      <td data-label="代碼"><code>${escapeHtml(t.編號代碼)}</code></td>
      <td data-label="設備數">${count}</td>
      <td class="action-cell">
        <button class="btn btn-sm" onclick="openEditType('${escapeAttr(t.類型名稱)}')">編輯</button>
        ${count === 0 ? `<button class="btn btn-sm btn-danger" onclick="deleteType('${escapeAttr(t.類型名稱)}')">刪除</button>` : ''}
      </td></tr>`;
  });
  if (!DATA.types.length) html += '<tr class="empty-row"><td colspan="4" class="empty">尚未建立任何類型</td></tr>';
  html += '</tbody>';
  document.getElementById('type-table').innerHTML = html;
}

function populateFilters() {
  const types = [...new Set(DATA.equipment.map(d => d.設備類型).filter(Boolean))].sort();
  const statuses = [...new Set(DATA.equipment.map(d => d.狀態).filter(Boolean))].sort();
  const depts = [...new Set(DATA.equipment.map(d => d.單位部門).filter(Boolean))].sort();
  document.getElementById('eq-type').innerHTML = '<option value="">所有類型</option>' + types.map(t => `<option value="${escapeAttr(t)}">${escapeHtml(t)}</option>`).join('');
  document.getElementById('eq-status').innerHTML = '<option value="">所有狀態</option>' + statuses.map(s => `<option value="${escapeAttr(s)}">${escapeHtml(s)}</option>`).join('');
  document.getElementById('eq-dept').innerHTML = '<option value="">所有部門</option>' + depts.map(d => `<option value="${escapeAttr(d)}">${escapeHtml(d)}</option>`).join('');
}

function renderAll() {
  renderStats();
  populateFilters();
  renderEquipment();
  renderEmployees();
  renderEvents();
  renderTypes();
}

// === 寫入後直接改本地狀態,不再向後端全量重抓 (大幅加快儲存) ===
function applyLocal(mutator) {
  mutator(DATA);
  buildIndexes();
  renderAll();
}

// 前端產生下一個設備編號 — 不用打 API
function nextDeviceIdLocal(typeCode) {
  if (!typeCode) return '';
  const year = String(new Date().getFullYear()).slice(2);
  let maxSeq = 0;
  DATA.equipment.forEach(d => {
    const id = String(d.設備編號 || '');
    if (id.startsWith(typeCode) && id.slice(2, 4) === year) {
      const seq = parseInt(id.slice(4), 10);
      if (!isNaN(seq) && seq > maxSeq) maxSeq = seq;
    }
  });
  return typeCode + year + String(maxSeq + 1).padStart(3, '0');
}

// ============ Modals ============
function showModal(html) {
  document.getElementById('modal-content').innerHTML = html;
  document.getElementById('modal-bg').classList.add('show');
}
function closeModal() {
  document.getElementById('modal-bg').classList.remove('show');
}

function options(arr, selected = '', placeholder = '') {
  return (placeholder ? `<option value="">${placeholder}</option>` : '') + arr.map(v => {
    const val = typeof v === 'object' ? v.value : v;
    const lbl = typeof v === 'object' ? v.label : v;
    return `<option value="${escapeAttr(val)}"${val===selected?' selected':''}>${escapeHtml(lbl)}</option>`;
  }).join('');
}

function statusOptions(sel='') {
  return options(['使用中','備用','已報廢','已送出'], sel, '— 選擇狀態 —');
}
function holdOptions(sel='') {
  return options(['使用中','保管中'], sel, '');
}
function deptOptions(sel='') {
  const depts = [...new Set([...DATA.equipment.map(d=>d.單位部門), ...DATA.employees.map(e=>e.部門)].filter(Boolean))].sort();
  return options(depts, sel, '— 選擇部門 —');
}
function typeOptions(sel='') {
  return options(DATA.types.map(t => t.類型名稱), sel, '— 選擇類型 —');
}
function employeeOptions(sel='') {
  const names = DATA.employees.filter(e => e.在職狀態==='在職').map(e => e.姓名).sort();
  return options(names, sel, '— 選擇員工 —');
}

// === Equipment add/edit ===
async function openAddEquipment() {
  showModal(`
    <h2>新增設備</h2>
    <div class="field-row">
      <div class="field"><label>設備類型 *</label><select id="f-type" onchange="autoFillId()">${typeOptions()}</select></div>
      <div class="field"><label>設備編號 *</label><input id="f-id" placeholder="自動產生 或自填"></div>
    </div>
    <div class="field-row">
      <div class="field"><label>使用者</label><select id="f-user">${employeeOptions()}</select></div>
      <div class="field"><label>保管狀態</label><select id="f-hold"><option value="使用中">使用中</option><option value="保管中">保管中</option></select></div>
    </div>
    <div class="field-row">
      <div class="field"><label>單位部門</label><select id="f-dept">${deptOptions()}</select></div>
      <div class="field"><label>狀態 *</label><select id="f-status"><option value="使用中">使用中</option><option value="備用">備用</option><option value="已報廢">已報廢</option><option value="已送出">已送出</option></select></div>
    </div>
    <div class="field-row">
      <div class="field"><label>購買日期</label><input type="date" id="f-date"></div>
      <div class="field"><label>購買價格(NTD)</label><input type="number" id="f-price"></div>
    </div>
    <div class="field"><label>設備明細</label><input id="f-detail" placeholder="型號、規格"></div>
    <div class="field"><label>目前位置</label><input id="f-loc"></div>
    <div class="field"><label>備註</label><textarea id="f-note"></textarea></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn" onclick="submitAddEquipment()">新增</button>
    </div>
  `);
}

function autoFillId() {
  const typeName = document.getElementById('f-type').value;
  if (!typeName) return;
  const t = DATA.types.find(x => x.類型名稱 === typeName);
  if (!t) return;
  document.getElementById('f-id').value = nextDeviceIdLocal(t.編號代碼);
}

async function submitAddEquipment() {
  const data = {
    設備編號: document.getElementById('f-id').value.trim(),
    設備類型: document.getElementById('f-type').value,
    使用者: document.getElementById('f-user').value,
    保管狀態: document.getElementById('f-hold').value,
    單位部門: document.getElementById('f-dept').value,
    狀態: document.getElementById('f-status').value,
    購買日期: document.getElementById('f-date').value,
    '購買價格(NTD)': document.getElementById('f-price').value,
    設備明細: document.getElementById('f-detail').value,
    目前位置: document.getElementById('f-loc').value,
    備註: document.getElementById('f-note').value
  };
  if (!data.設備編號 || !data.設備類型) { showToast('請填設備編號和類型', 'error'); return; }
  try {
    await api('addEquipment', {data});
    closeModal();
    showToast('新增成功', 'success');
    applyLocal(D => D.equipment.push(data));
  } catch (e) { showToast(e.message, 'error'); }
}

function openEditEquipment(id) {
  const d = DATA.equipment.find(x => x.設備編號 === id);
  if (!d) return;
  showModal(`
    <h2>編輯設備 ${escapeHtml(id)}</h2>
    <div class="field-row">
      <div class="field"><label>設備類型</label><select id="f-type">${typeOptions(d.設備類型)}</select></div>
      <div class="field"><label>使用者</label><select id="f-user">${options([...new Set(DATA.employees.map(e=>e.姓名))].sort(), d.使用者, '— 無 —')}</select></div>
    </div>
    <div class="field-row">
      <div class="field"><label>保管狀態</label><select id="f-hold">${holdOptions(d.保管狀態)}</select></div>
      <div class="field"><label>狀態</label><select id="f-status">${statusOptions(d.狀態)}</select></div>
    </div>
    <div class="field"><label>單位部門</label><select id="f-dept">${deptOptions(d.單位部門)}</select></div>
    <div class="field-row">
      <div class="field"><label>購買日期</label><input type="date" id="f-date" value="${escapeAttr(d.購買日期)}"></div>
      <div class="field"><label>購買價格(NTD)</label><input type="number" id="f-price" value="${escapeAttr(d['購買價格(NTD)'])}"></div>
    </div>
    <div class="field"><label>設備明細</label><input id="f-detail" value="${escapeAttr(d.設備明細)}"></div>
    <div class="field"><label>目前位置</label><input id="f-loc" value="${escapeAttr(d.目前位置)}"></div>
    <div class="field"><label>備註</label><textarea id="f-note">${escapeHtml(d.備註)}</textarea></div>
    <div class="modal-actions">
      <button class="btn btn-danger" onclick="deleteEquipment('${escapeAttr(id)}')">刪除</button>
      <button class="btn btn-ghost" onclick="closeModal()" style="margin-left:auto">取消</button>
      <button class="btn" onclick="submitEditEquipment('${escapeAttr(id)}')">儲存</button>
    </div>
  `);
}

async function submitEditEquipment(id) {
  const data = {
    設備類型: document.getElementById('f-type').value,
    使用者: document.getElementById('f-user').value,
    保管狀態: document.getElementById('f-hold').value,
    單位部門: document.getElementById('f-dept').value,
    狀態: document.getElementById('f-status').value,
    購買日期: document.getElementById('f-date').value,
    '購買價格(NTD)': document.getElementById('f-price').value,
    設備明細: document.getElementById('f-detail').value,
    目前位置: document.getElementById('f-loc').value,
    備註: document.getElementById('f-note').value
  };
  try {
    await api('updateEquipment', {id, data});
    closeModal();
    showToast('已更新', 'success');
    applyLocal(D => {
      const i = D.equipment.findIndex(x => x.設備編號 === id);
      if (i >= 0) D.equipment[i] = Object.assign({}, D.equipment[i], data);
    });
  } catch (e) { showToast(e.message, 'error'); }
}

async function deleteEquipment(id) {
  if (!confirm(`確定要刪除設備 ${id} 嗎?(此動作無法復原)`)) return;
  try {
    await api('deleteEquipment', {id});
    closeModal();
    showToast('已刪除', 'success');
    applyLocal(D => {
      D.equipment = D.equipment.filter(x => x.設備編號 !== id);
    });
  } catch (e) { showToast(e.message, 'error'); }
}

// === Transfer / Scrap / Send out ===
function openTransfer(id) {
  const d = DATA.equipment.find(x => x.設備編號 === id);
  if (!d) return;
  const today = new Date().toISOString().slice(0,10);
  showModal(`
    <h2>轉移設備 ${escapeHtml(id)}</h2>
    <p class="notice notice-info">會自動更新「設備主表」的使用者欄並新增一筆異動記錄</p>
    <div class="field-row">
      <div class="field"><label>日期</label><input type="date" id="f-date" value="${today}"></div>
      <div class="field"><label>原使用者</label><input id="f-from" value="${escapeAttr(d.使用者)}"></div>
    </div>
    <div class="field"><label>新使用者 *</label><select id="f-to">${options([...new Set(DATA.employees.filter(e=>e.在職狀態==='在職').map(e=>e.姓名))].sort(), '', '— 選擇員工 —')}</select></div>
    <div class="field-row">
      <div class="field"><label>新保管狀態</label><select id="f-hold">${holdOptions(d.保管狀態)}</select></div>
      <div class="field"><label>新部門(選填,留空維持原值)</label><select id="f-dept">${deptOptions()}</select></div>
    </div>
    <div class="field"><label>原因 / 備註</label><textarea id="f-reason"></textarea></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn btn-warning" onclick="submitTransfer('${escapeAttr(id)}')">執行轉移</button>
    </div>
  `);
}
async function submitTransfer(id) {
  const newUser = document.getElementById('f-to').value;
  if (!newUser) { showToast('請選新使用者', 'error'); return; }
  const date = document.getElementById('f-date').value;
  const fromUser = document.getElementById('f-from').value;
  const newHold = document.getElementById('f-hold').value;
  const newDept = document.getElementById('f-dept').value;
  const reason = document.getElementById('f-reason').value;
  try {
    await api('transfer', {
      deviceId: id,
      date,
      原使用者: fromUser,
      新使用者: newUser,
      新保管狀態: newHold,
      新部門: newDept,
      原因: reason
    });
    closeModal();
    showToast('轉移完成', 'success');
    applyLocal(D => {
      const eq = D.equipment.find(x => x.設備編號 === id);
      if (eq) {
        eq.使用者 = newUser;
        if (newHold) eq.保管狀態 = newHold;
        if (newDept) eq.單位部門 = newDept;
      }
      D.events.push({
        日期: date, 設備編號: id, 原使用者: fromUser, 新使用者: newUser,
        新保管狀態: newHold || '',
        異動類型: '轉移', 原因: reason
      });
    });
  } catch (e) { showToast(e.message, 'error'); }
}

function openMore(id) {
  const d = DATA.equipment.find(x => x.設備編號 === id);
  if (!d) return;
  showModal(`
    <h2>${escapeHtml(id)} 更多操作</h2>
    <div style="display:flex; flex-direction:column; gap:10px; margin-top:14px">
      <button class="btn btn-warning" onclick="openScrap('${escapeAttr(id)}')">⚠️ 標記為報廢</button>
      <button class="btn" onclick="openSendOut('${escapeAttr(id)}')">📤 標記為已送出</button>
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
    </div>
  `);
}

function openScrap(id) {
  const d = DATA.equipment.find(x => x.設備編號 === id);
  const today = new Date().toISOString().slice(0,10);
  showModal(`
    <h2>報廢設備 ${escapeHtml(id)}</h2>
    <p class="notice notice-error">會把設備狀態改為「已報廢」、清空使用者,並新增一筆報廢記錄</p>
    <div class="field"><label>日期</label><input type="date" id="f-date" value="${today}"></div>
    <div class="field"><label>原使用者</label><input id="f-from" value="${escapeAttr(d.使用者)}"></div>
    <div class="field"><label>報廢原因</label><textarea id="f-reason" placeholder="例:win7 無法更新、硬體故障等"></textarea></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn btn-danger" onclick="submitScrap('${escapeAttr(id)}')">確認報廢</button>
    </div>
  `);
}
async function submitScrap(id) {
  const date = document.getElementById('f-date').value;
  const fromUser = document.getElementById('f-from').value;
  const reason = document.getElementById('f-reason').value;
  try {
    await api('scrap', {deviceId: id, date, 原使用者: fromUser, 原因: reason});
    closeModal();
    showToast('已標記報廢', 'success');
    applyLocal(D => {
      const eq = D.equipment.find(x => x.設備編號 === id);
      if (eq) { eq.狀態 = '已報廢'; eq.使用者 = ''; eq.保管狀態 = ''; }
      D.events.push({
        日期: date, 設備編號: id, 原使用者: fromUser, 新使用者: '',
        異動類型: '報廢', 原因: reason
      });
    });
  } catch (e) { showToast(e.message, 'error'); }
}

function openSendOut(id) {
  const d = DATA.equipment.find(x => x.設備編號 === id);
  const today = new Date().toISOString().slice(0,10);
  showModal(`
    <h2>送出設備 ${escapeHtml(id)}</h2>
    <p class="notice notice-info">會把設備狀態改為「已送出」並新增一筆送出記錄</p>
    <div class="field"><label>日期</label><input type="date" id="f-date" value="${today}"></div>
    <div class="field"><label>原使用者</label><input id="f-from" value="${escapeAttr(d.使用者)}"></div>
    <div class="field"><label>接收方</label><input id="f-to" placeholder="例:行銷企劃部 / 2F承接戶"></div>
    <div class="field"><label>原因 / 備註</label><textarea id="f-reason"></textarea></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn" onclick="submitSendOut('${escapeAttr(id)}')">確認送出</button>
    </div>
  `);
}
async function submitSendOut(id) {
  const date = document.getElementById('f-date').value;
  const fromUser = document.getElementById('f-from').value;
  const recipient = document.getElementById('f-to').value;
  const reason = document.getElementById('f-reason').value;
  try {
    await api('sendOut', {deviceId: id, date, 原使用者: fromUser, 接收方: recipient, 原因: reason});
    closeModal();
    showToast('已標記送出', 'success');
    applyLocal(D => {
      const eq = D.equipment.find(x => x.設備編號 === id);
      if (eq) { eq.狀態 = '已送出'; eq.使用者 = ''; eq.保管狀態 = ''; }
      D.events.push({
        日期: date, 設備編號: id, 原使用者: fromUser, 新使用者: recipient,
        異動類型: '送出', 原因: reason
      });
    });
  } catch (e) { showToast(e.message, 'error'); }
}

// === Employee add/edit ===
function openAddEmployee() {
  showModal(`
    <h2>新增員工</h2>
    <div class="field"><label>姓名 *</label><input id="f-name" required></div>
    <div class="field"><label>部門</label><select id="f-dept">${deptOptions()}</select></div>
    <div class="field"><label>在職狀態</label><select id="f-status"><option value="在職">在職</option><option value="已離職">已離職</option></select></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn" onclick="submitAddEmployee()">新增</button>
    </div>
  `);
}
async function submitAddEmployee() {
  const data = {
    姓名: document.getElementById('f-name').value.trim(),
    部門: document.getElementById('f-dept').value,
    在職狀態: document.getElementById('f-status').value
  };
  if (!data.姓名) { showToast('請填姓名', 'error'); return; }
  try {
    await api('addEmployee', {data});
    closeModal();
    showToast('新增成功', 'success');
    applyLocal(D => D.employees.push(data));
  } catch (e) { showToast(e.message, 'error'); }
}

function openEditEmployee(name) {
  const e = DATA.employees.find(x => x.姓名 === name);
  if (!e) return;
  showModal(`
    <h2>編輯員工 ${escapeHtml(name)}</h2>
    <div class="field"><label>姓名(修改名字會把設備主表/異動記錄的相關欄位錯開,請先確認)</label><input id="f-name" value="${escapeAttr(e.姓名)}"></div>
    <div class="field"><label>部門</label><select id="f-dept">${deptOptions(e.部門)}</select></div>
    <div class="field"><label>在職狀態</label><select id="f-status"><option value="在職"${e.在職狀態==='在職'?' selected':''}>在職</option><option value="已離職"${(e.在職狀態==='已離職'||e.在職狀態==='已離職/未知')?' selected':''}>已離職</option></select></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn" onclick="submitEditEmployee('${escapeAttr(name)}')">儲存</button>
    </div>
  `);
}
async function submitEditEmployee(oldName) {
  const data = {
    姓名: document.getElementById('f-name').value.trim(),
    部門: document.getElementById('f-dept').value,
    在職狀態: document.getElementById('f-status').value
  };
  if (!data.姓名) { showToast('姓名不可空', 'error'); return; }
  try {
    await api('updateEmployee', {name: oldName, data});
    closeModal();
    showToast('已更新', 'success');
    applyLocal(D => {
      const i = D.employees.findIndex(x => x.姓名 === oldName);
      if (i >= 0) D.employees[i] = Object.assign({}, D.employees[i], data);
    });
  } catch (e) { showToast(e.message, 'error'); }
}

async function deleteEmployee(name) {
  if (!confirm(`確定要刪除員工 ${name} 嗎?`)) return;
  try {
    await api('deleteEmployee', {name});
    showToast('已刪除', 'success');
    applyLocal(D => { D.employees = D.employees.filter(x => x.姓名 !== name); });
  } catch (e) { showToast(e.message, 'error'); }
}

// === Type add/edit ===
function openAddType() {
  showModal(`
    <h2>新增設備類型</h2>
    <div class="field"><label>類型名稱 *</label><input id="f-name" placeholder="例:平板"></div>
    <div class="field"><label>編號代碼 * (2 個英文字母大寫)</label><input id="f-code" maxlength="2" style="text-transform:uppercase" placeholder="例:PT"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn" onclick="submitAddType()">新增</button>
    </div>
  `);
}
async function submitAddType() {
  const data = {
    類型名稱: document.getElementById('f-name').value.trim(),
    編號代碼: document.getElementById('f-code').value.trim().toUpperCase()
  };
  if (!data.類型名稱 || !data.編號代碼) { showToast('請填類型名稱與編號代碼', 'error'); return; }
  try {
    await api('addType', {data});
    closeModal();
    showToast('已新增', 'success');
    applyLocal(D => D.types.push(data));
  } catch (e) { showToast(e.message, 'error'); }
}

function openEditType(name) {
  const t = DATA.types.find(x => x.類型名稱 === name);
  if (!t) return;
  showModal(`
    <h2>編輯設備類型</h2>
    <div class="field"><label>類型名稱</label><input id="f-name" value="${escapeAttr(t.類型名稱)}"></div>
    <div class="field"><label>編號代碼</label><input id="f-code" maxlength="2" style="text-transform:uppercase" value="${escapeAttr(t.編號代碼)}"></div>
    <div class="modal-actions">
      <button class="btn btn-ghost" onclick="closeModal()">取消</button>
      <button class="btn" onclick="submitEditType('${escapeAttr(name)}')">儲存</button>
    </div>
  `);
}
async function submitEditType(oldName) {
  const data = {
    類型名稱: document.getElementById('f-name').value.trim(),
    編號代碼: document.getElementById('f-code').value.trim().toUpperCase()
  };
  try {
    await api('updateType', {oldName, data});
    closeModal();
    showToast('已更新', 'success');
    applyLocal(D => {
      const i = D.types.findIndex(x => x.類型名稱 === oldName);
      if (i >= 0) D.types[i] = Object.assign({}, D.types[i], data);
    });
  } catch (e) { showToast(e.message, 'error'); }
}
async function deleteType(name) {
  if (!confirm(`刪除類型「${name}」?`)) return;
  try {
    await api('deleteType', {name});
    showToast('已刪除', 'success');
    applyLocal(D => { D.types = D.types.filter(x => x.類型名稱 !== name); });
  } catch (e) { showToast(e.message, 'error'); }
}

// ============ 匯出 Excel(各部門電腦設備清單) ============

const _EXPORT_TYPES = ['桌上型電腦','筆記型電腦','iMac','MacBook','平板','智慧型手機','螢幕','電視','其他'];

function _todayStrSlash() {
  const d = new Date();
  return d.getFullYear() + '/' + String(d.getMonth()+1).padStart(2,'0') + '/' + String(d.getDate()).padStart(2,'0');
}
function _todayStrCompact() {
  const d = new Date();
  return d.getFullYear() + String(d.getMonth()+1).padStart(2,'0') + String(d.getDate()).padStart(2,'0');
}

// 樣式預設
const _BORDER = {top:{style:'thin',color:{rgb:'B0B7BE'}}, bottom:{style:'thin',color:{rgb:'B0B7BE'}}, left:{style:'thin',color:{rgb:'B0B7BE'}}, right:{style:'thin',color:{rgb:'B0B7BE'}}};
const _STYLE_TITLE = {font:{bold:true, sz:16, color:{rgb:'2C3E50'}}, alignment:{horizontal:'center', vertical:'center'}};
const _STYLE_DATE = {font:{sz:11, color:{rgb:'7F8C8D'}}, alignment:{horizontal:'right', vertical:'center'}};
const _STYLE_HEADER = {font:{bold:true, color:{rgb:'FFFFFF'}, sz:11}, fill:{fgColor:{rgb:'4A90E2'}}, alignment:{horizontal:'center', vertical:'center'}, border:_BORDER};
const _STYLE_CENTER = {alignment:{horizontal:'center', vertical:'center'}, border:_BORDER};
const _STYLE_LEFT_WRAP = {alignment:{horizontal:'left', vertical:'center', wrapText:true}, border:_BORDER};
const _STYLE_NOTE_HOLD = {font:{italic:true, sz:10, color:{rgb:'888888'}}, alignment:{horizontal:'left'}};
const _STYLE_STAT_HEADER = {font:{bold:true, color:{rgb:'FFFFFF'}}, fill:{fgColor:{rgb:'4A90E2'}}, alignment:{horizontal:'center', vertical:'center'}, border:_BORDER};
const _STYLE_STAT_LABEL = {font:{bold:true}, fill:{fgColor:{rgb:'EAF4FC'}}, alignment:{horizontal:'center', vertical:'center'}, border:_BORDER};
// 「統計」抬頭文字 — 無底色、無框線
const _STYLE_STAT_TITLE = {font:{bold:true, sz:12, color:{rgb:'2C3E50'}}, alignment:{horizontal:'center', vertical:'center'}};
const _STYLE_STAT_NUM = {fill:{fgColor:{rgb:'F8FAFC'}}, alignment:{horizontal:'center', vertical:'center'}, border:_BORDER};
const _STYLE_STAT_TOTAL = {font:{bold:true, color:{rgb:'C0392B'}}, fill:{fgColor:{rgb:'FEF3C7'}}, alignment:{horizontal:'center', vertical:'center'}, border:_BORDER};
const _STYLE_SIGN_TEXT = {font:{bold:true, sz:12}, alignment:{horizontal:'left', vertical:'center'}};
const _STYLE_SIGN_LINE = {border:{bottom:{style:'thin', color:{rgb:'000000'}}}};

// 畫簽章:標籤位於 col,底線從 col+1 延伸到 maxCol(含)
// 底線不會覆蓋到「主管簽章」標籤格,也不會超過表格最後一欄(maxCol)
function _drawSignature(ws, row, col, maxCol) {
  _setCell(ws, _ref(row, col), '主管簽章', _STYLE_SIGN_TEXT);
  for (let c = col + 1; c <= maxCol; c++) {
    _setCell(ws, _ref(row + 1, c), '', _STYLE_SIGN_LINE);
  }
}

// 列印設定:預設橫式 + 水平/垂直置中
// 同時設定多個可能的屬性名稱以提高跨版本相容性
function _applyPrintLayout(ws) {
  ws['!margins'] = { left: 0.5, right: 0.5, top: 0.75, bottom: 0.75, header: 0.3, footer: 0.3 };
  // 橫式 A4(paperSize: 9 = A4)
  ws['!pageSetup'] = {
    orientation: 'landscape',
    paperSize: 9,
    fitToWidth: 1,
    fitToHeight: 0,
    scale: 100,
    // 部分版本以這個屬性讀取
    horizontalCentered: 1,
    verticalCentered: 1
  };
  // 列印置中(標準 SheetJS / xlsx-js-style 寫入 <printOptions>)
  ws['!printOptions'] = { horizontalCentered: true, verticalCentered: true };
  // 強制以橫式呈現(預備鍵,部分 fork 會讀取)
  ws['!sheetPr'] = ws['!sheetPr'] || {};
}

function _setCell(ws, ref, value, style) {
  const t = (typeof value === 'number') ? 'n' : 's';
  ws[ref] = {v: value, t};
  if (style) ws[ref].s = style;
}
function _ref(r, c) { return XLSX.utils.encode_cell({r, c}); }

function _applyStyleToRange(ws, r1, c1, r2, c2, style) {
  for (let r = r1; r <= r2; r++) {
    for (let c = c1; c <= c2; c++) {
      const ref = _ref(r, c);
      if (!ws[ref]) ws[ref] = {v:'', t:'s'};
      ws[ref].s = style;
    }
  }
}

function _setRange(ws, r1, c1, r2, c2) {
  const cur = ws['!ref'] ? XLSX.utils.decode_range(ws['!ref']) : {s:{r:0,c:0}, e:{r:0,c:0}};
  const newR = {
    s: {r: Math.min(cur.s.r, r1), c: Math.min(cur.s.c, c1)},
    e: {r: Math.max(cur.e.r, r2), c: Math.max(cur.e.c, c2)}
  };
  ws['!ref'] = XLSX.utils.encode_range(newR);
}

// 計算備註欄內容:位置 + 設備明細(換行)
function _composeRemark(d) {
  const lines = [];
  if (d.目前位置) lines.push('位置:' + d.目前位置);
  if (d.設備明細) lines.push(d.設備明細);
  return lines.join('\n');
}

function buildDeptSheet(deptName, items, today) {
  // 排序:類型 → 編號
  items.sort((a, b) => {
    const ta = _EXPORT_TYPES.indexOf(a.設備類型);
    const tb = _EXPORT_TYPES.indexOf(b.設備類型);
    if (ta !== tb) return (ta < 0 ? 99 : ta) - (tb < 0 ? 99 : tb);
    return (a.設備編號||'').localeCompare(b.設備編號||'');
  });

  const ws = {};
  // 欄位:設備編號 | 設備類型 | 使用者 | 單位部門 | 購買日期 | 購買價格 | 備註
  const headers = ['設備編號','設備類型','使用者','單位部門','購買日期','購買價格','備註'];
  const NCOL = headers.length;  // 7

  // R1 標題(置中,跨欄合併)
  _setCell(ws, 'A1', `${deptName}電腦設備清單`, _STYLE_TITLE);
  // R3 建表日期(右對齊在表格最右側 = G3)
  _setCell(ws, _ref(2, NCOL-1), `建表日期:${today}`, _STYLE_DATE);
  // R5 表頭
  headers.forEach((h, i) => _setCell(ws, _ref(4, i), h, _STYLE_HEADER));

  let hasHold = false;
  let rowIdx = 5;
  items.forEach(d => {
    const user = (d.保管狀態 === '保管中' && d.使用者) ? '*' + d.使用者 : (d.使用者 || '');
    if (d.保管狀態 === '保管中' && d.使用者) hasHold = true;
    const price = d['購買價格(NTD)'];
    const remark = _composeRemark(d);
    _setCell(ws, _ref(rowIdx, 0), d.設備編號 || '', _STYLE_CENTER);
    _setCell(ws, _ref(rowIdx, 1), d.設備類型 || '', _STYLE_CENTER);
    _setCell(ws, _ref(rowIdx, 2), user, _STYLE_CENTER);
    _setCell(ws, _ref(rowIdx, 3), d.單位部門 || deptName, _STYLE_CENTER);
    _setCell(ws, _ref(rowIdx, 4), d.購買日期 || '', _STYLE_CENTER);
    _setCell(ws, _ref(rowIdx, 5), price ? Number(price) : '', _STYLE_CENTER);
    _setCell(ws, _ref(rowIdx, 6), remark, _STYLE_LEFT_WRAP);
    rowIdx++;
  });

  // 保管註腳
  if (hasHold) {
    rowIdx++;
    _setCell(ws, _ref(rowIdx, 2), '註: * 字號為保管人員非本人使用', _STYLE_NOTE_HOLD);
    rowIdx++;
  }

  // 統計小區(項目|數量)
  rowIdx += 2;
  const statsStart = rowIdx;
  // 統計每類型數量
  const typeCounts = _EXPORT_TYPES
    .map(t => ({type: t, count: items.filter(d => d.設備類型 === t).length}))
    .filter(x => x.count > 0);

  // 統計區佈局:單欄(<=3 類型)或雙欄(>=4 類型)
  const useDoubleCol = typeCounts.length >= 4;

  // 「統計」抬頭使用純文字樣式(無底色、無框線)
  _setCell(ws, _ref(rowIdx, 0), '統計', _STYLE_STAT_TITLE);
  _setCell(ws, _ref(rowIdx, 1), '項目', _STYLE_STAT_HEADER);
  _setCell(ws, _ref(rowIdx, 2), '數量', _STYLE_STAT_HEADER);
  if (useDoubleCol) {
    _setCell(ws, _ref(rowIdx, 3), '項目', _STYLE_STAT_HEADER);
    _setCell(ws, _ref(rowIdx, 4), '數量', _STYLE_STAT_HEADER);
  }
  rowIdx++;

  let leftItems, rightItems;
  if (useDoubleCol) {
    const half = Math.ceil(typeCounts.length / 2);
    leftItems = typeCounts.slice(0, half);
    rightItems = typeCounts.slice(half);
  } else {
    leftItems = typeCounts;
    rightItems = [];
  }
  const maxStatRows = Math.max(leftItems.length, rightItems.length);
  for (let i = 0; i < maxStatRows; i++) {
    if (leftItems[i]) {
      _setCell(ws, _ref(rowIdx, 1), leftItems[i].type, _STYLE_STAT_LABEL);
      _setCell(ws, _ref(rowIdx, 2), leftItems[i].count, _STYLE_STAT_NUM);
    }
    if (rightItems[i]) {
      _setCell(ws, _ref(rowIdx, 3), rightItems[i].type, _STYLE_STAT_LABEL);
      _setCell(ws, _ref(rowIdx, 4), rightItems[i].count, _STYLE_STAT_NUM);
    }
    rowIdx++;
  }

  // 主管簽章區:放在統計區「右邊」,與統計區垂直置中對齊
  // 統計區佔用的欄位:單欄=0~2,雙欄=0~4。簽章標籤緊接其後,底線延伸至 NCOL-1
  const signLabelCol = useDoubleCol ? 5 : 3;
  const signRow = statsStart + Math.max(0, Math.floor(maxStatRows / 2));
  _drawSignature(ws, signRow, signLabelCol, NCOL - 1);
  // 簽章佔據 signRow 與 signRow+1 兩列,讓最終範圍包含到底線那列
  if (rowIdx < signRow + 2) rowIdx = signRow + 2;

  // 設定範圍與合併:標題合併僅跨表格欄位寬度(0 ~ NCOL-1),不超出
  _setRange(ws, 0, 0, rowIdx, NCOL - 1);
  ws['!merges'] = [
    {s:{r:0,c:0}, e:{r:0,c:NCOL-1}}  // 標題列合併,僅跨表格欄位寬度
  ];
  ws['!cols'] = [
    {wch: 12}, {wch: 12}, {wch: 14}, {wch: 14},
    {wch: 12}, {wch: 12}, {wch: 32}
  ];
  ws['!rows'] = [{hpt: 28}];  // 標題列高度

  // 列印時水平+垂直置中
  _applyPrintLayout(ws);

  return ws;
}

function buildStatsSheet(byDept, today) {
  const headers = ['部門', ..._EXPORT_TYPES, '總計'];
  const NCOL = headers.length;
  const ws = {};

  _setCell(ws, 'A1', '極速超跑電腦設備統計', _STYLE_TITLE);
  _setCell(ws, _ref(2, NCOL-1), `建表日期:${today}`, _STYLE_DATE);
  headers.forEach((h, i) => _setCell(ws, _ref(4, i), h, _STYLE_HEADER));

  const depts = Object.keys(byDept).sort();
  const colTotals = new Array(_EXPORT_TYPES.length).fill(0);
  let grandTotal = 0;
  let rowIdx = 5;
  depts.forEach(dept => {
    _setCell(ws, _ref(rowIdx, 0), dept, _STYLE_STAT_LABEL);
    let rowTotal = 0;
    _EXPORT_TYPES.forEach((t, i) => {
      const count = byDept[dept].filter(d => d.設備類型 === t).length;
      _setCell(ws, _ref(rowIdx, i+1), count || '', _STYLE_STAT_NUM);
      colTotals[i] += count;
      rowTotal += count;
    });
    _setCell(ws, _ref(rowIdx, NCOL-1), rowTotal, _STYLE_STAT_TOTAL);
    grandTotal += rowTotal;
    rowIdx++;
  });
  // 統計行
  _setCell(ws, _ref(rowIdx, 0), '統計', _STYLE_STAT_LABEL);
  colTotals.forEach((c, i) => _setCell(ws, _ref(rowIdx, i+1), c || '', _STYLE_STAT_TOTAL));
  _setCell(ws, _ref(rowIdx, NCOL-1), grandTotal, _STYLE_STAT_TOTAL);
  rowIdx++;

  // 主管簽章:標籤位於 NCOL-5 欄,底線延伸到表格最後一欄(不覆蓋標籤、不超出表格)
  rowIdx += 3;
  const signLabelCol = Math.max(0, NCOL - 5);
  _drawSignature(ws, rowIdx, signLabelCol, NCOL - 1);

  _setRange(ws, 0, 0, rowIdx+1, NCOL-1);
  ws['!merges'] = [{s:{r:0,c:0}, e:{r:0,c:NCOL-1}}];
  ws['!cols'] = [{wch: 14}, ..._EXPORT_TYPES.map(()=>({wch: 11})), {wch: 10}];
  ws['!rows'] = [{hpt: 28}];

  // 列印時水平+垂直置中
  _applyPrintLayout(ws);
  return ws;
}

async function exportExcel() {
  if (typeof XLSX === 'undefined') {
    showToast('Excel 函式庫未載入,請檢查網路', 'error');
    return;
  }
  try {
    const today = _todayStrSlash();
    const fileDate = _todayStrCompact();
    const wb = XLSX.utils.book_new();

    // 1. 各部門分頁(排除已報廢、已送出)
    const byDept = {};
    DATA.equipment.forEach(d => {
      if (d.狀態 === '已報廢' || d.狀態 === '已送出') return;
      const dept = d.單位部門 || '未分類';
      if (!byDept[dept]) byDept[dept] = [];
      byDept[dept].push(d);
    });
    const deptOrder = Object.keys(byDept).sort();
    deptOrder.forEach(dept => {
      const ws = buildDeptSheet(dept, byDept[dept].slice(), today);
      let name = dept.slice(0, 31).replace(/[\\\/\?\*\[\]:]/g, '_');
      XLSX.utils.book_append_sheet(wb, ws, name);
    });

    // 2. 統計
    const wsStats = buildStatsSheet(byDept, today);
    XLSX.utils.book_append_sheet(wb, wsStats, '統計');

    const filename = `各部門電腦設備清單_${fileDate}.xlsx`;
    XLSX.writeFile(wb, filename);
    showToast('已匯出 ' + filename, 'success');
  } catch (e) {
    console.error(e);
    showToast('匯出失敗:' + e.message, 'error');
  }
}

// ============ Helpers ============
function escapeHtml(s) {
  if (s === null || s === undefined) return '';
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(s) { return escapeHtml(s).replace(/`/g,'&#96;'); }

function showLoading(b) {
  document.getElementById('loading').classList.toggle('show', b);
}
function showToast(msg, type='') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'toast show ' + type;
  setTimeout(() => t.classList.remove('show'), 2500);
}

// ============ Setup ============
function loadConfig() {
  try {
    const raw = localStorage.getItem(SETTINGS_KEY);
    if (raw) CONFIG = JSON.parse(raw);
  } catch(e) {}
}
function saveConfig() {
  localStorage.setItem(SETTINGS_KEY, JSON.stringify(CONFIG));
}

async function trySetup() {
  const url = document.getElementById('setup-url').value.trim();
  const key = document.getElementById('setup-key').value.trim();
  const msg = document.getElementById('setup-msg');
  if (!url || !key) { msg.innerHTML = '<div class="error">請填寫兩個欄位</div>'; return; }
  msg.innerHTML = '連線中…';
  CONFIG = {url, key};
  try {
    const data = await api('read');
    msg.innerHTML = `<div class="ok">✅ 連線成功:設備 ${data.equipment.length} 筆 / 員工 ${data.employees.length} 人 / 異動 ${data.events.length} 筆 / 類型 ${data.types.length} 種</div>`;
    saveConfig();
    DATA = data;
    setTimeout(initDashboard, 800);
  } catch(e) {
    msg.innerHTML = `<div class="error">❌ ${escapeHtml(e.message)}</div>`;
  }
}

function showSetup() {
  document.getElementById('setup').style.display = 'block';
  document.getElementById('dashboard').style.display = 'none';
  document.getElementById('setup-url').value = CONFIG.url || '';
  document.getElementById('setup-key').value = CONFIG.key || '';
}

function initDashboard() {
  document.getElementById('setup').style.display = 'none';
  document.getElementById('dashboard').style.display = 'block';
  buildIndexes();
  renderAll();
}

// ============ Init ============
document.querySelectorAll('.tab').forEach(t => {
  t.onclick = () => {
    document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
    t.classList.add('active');
    ['equipment','employees','events','types'].forEach(n => {
      document.getElementById('panel-'+n).style.display = n === t.dataset.tab ? 'block' : 'none';
    });
  };
});

['eq-search','eq-type','eq-status','eq-dept'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderEquipment);
  document.getElementById(id).addEventListener('change', renderEquipment);
});
['emp-search','emp-status'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderEmployees);
  document.getElementById(id).addEventListener('change', renderEmployees);
});
['ev-search','ev-type'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderEvents);
  document.getElementById(id).addEventListener('change', renderEvents);
});

document.getElementById('refresh-btn').onclick = refresh;
document.getElementById('export-btn').onclick = exportExcel;
document.getElementById('settings-btn').onclick = showSetup;
document.getElementById('setup-btn').onclick = trySetup;

loadConfig();
if (CONFIG.url && CONFIG.key) {
  refresh().then(() => {
    if (DATA.equipment.length || DATA.employees.length) initDashboard();
    else showSetup();
  }).catch(() => showSetup());
} else {
  showSetup();
}
</script>
</body>
</html>
